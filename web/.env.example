# Copy to .env.local for local development, or set these in Vercel → Project → Settings →
# Environment Variables. Leave the Clover values empty to run in demo mode (built-in menu,
# pretend payments, orders kept in memory).

# ---- Public (shown in the browser; changing them needs a rebuild) ----
# "sandbox" for Clover's test environment, "production" for the real restaurant.
NEXT_PUBLIC_CLOVER_ENV=sandbox
# Shahzeb's Clover merchant ID (13 characters, shown in the Clover dashboard URL).
NEXT_PUBLIC_CLOVER_MERCHANT_ID=
# Ecommerce public key (Clover dashboard → Settings → Ecommerce → Ecommerce API Tokens,
# integration type "Hosted iFrame + API/SDK").
NEXT_PUBLIC_CLOVER_PUBLIC_KEY=
# Turn either payment option off with "off".
NEXT_PUBLIC_ONLINE_PAYMENTS=on
NEXT_PUBLIC_PAY_AT_PICKUP=on
# The site's own address, e.g. https://order.shawarmabay.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode takes orders around the clock; set to "on" to use the real hours in demo too.
NEXT_PUBLIC_DEMO_REAL_HOURS=off

# ---- Server only (secret) ----
# Clover Platform API token: reads the menu, creates and prints orders.
CLOVER_API_TOKEN=
# Ecommerce private key from the same Ecommerce API Tokens screen: charges cards.
CLOVER_ECOMMERCE_PRIVATE_KEY=
# Optional: the Clover order type for online orders (otherwise one named like
# "Online" / "Pickup" / "To Go" is picked automatically).
CLOVER_ORDER_TYPE_ID=
# PIN for the in-store order screen at /kitchen (demo mode uses 1234).
KITCHEN_PIN=
# Optional: random string used to sign the order screen's login cookie.
KITCHEN_SECRET=
# Set to "off" to hide the two sample orders in demo mode.
DEMO_SAMPLE_ORDERS=on
