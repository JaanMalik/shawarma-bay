{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@web/*": ["../web/src/*"],
      "@mobile/*": ["../mobile/src/*"],
      "@/*": ["../web/src/*", "../mobile/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
