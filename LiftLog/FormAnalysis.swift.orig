import Foundation

// The form check logic that needs no camera, Vision or network: joint geometry, finding the reps,
// measuring them, picking the key frames and the saved result. PoseTracker finds the joints in the
// video and FormCoachAPI talks to Claude. No SwiftUI, Vision or UIKit here, so Checks/main.swift
// can verify it.

// MARK: - Pose data

/// The joints LiftLog tracks, named as Apple's Vision framework names them.
enum BodyJoint: String, CaseIterable, Codable {
    case nose, neck
    case leftShoulder, rightShoulder
    case leftElbow, rightElbow
    case leftWrist, rightWrist
    case leftHip, rightHip, root
    case leftKnee, rightKnee
    case leftAnkle, rightAnkle
}

enum BodySide: String, Codable, CaseIterable {
    case left, right

    var other: BodySide { self == .left ? .right : .left }
    var shoulder: BodyJoint { self == .left ? .leftShoulder : .rightShoulder }
    var elbow: BodyJoint { self == .left ? .leftElbow : .rightElbow }
    var wrist: BodyJoint { self == .left ? .leftWrist : .rightWrist }
    var hip: BodyJoint { self == .left ? .leftHip : .rightHip }
    var knee: BodyJoint { self == .left ? .leftKnee : .rightKnee }
    var ankle: BodyJoint { self == .left ? .leftAnkle : .rightAnkle }
}

/// Where a joint is in the upright video frame. x and y run from 0 to 1, with y = 0 at the top.
struct JointPoint: Codable, Hashable {
    var x: Double
    var y: Double
    var confidence: Double
}

/// The lifter's pose at one moment of the video.
struct PoseSample: Codable, Hashable {
    /// Seconds from the start of the video.
    var time: Double
    /// Keyed by `BodyJoint` raw value. Joints the phone couldn't find are left out.
    var joints: [String: JointPoint]

    /// Below this, a joint counts as not seen.
    static let minimumConfidence = 0.3

    func point(_ joint: BodyJoint) -> JointPoint? {
        guard let p = joints[joint.rawValue], p.confidence >= Self.minimumConfidence else { return nil }
        return p
    }
}

/// Every pose found in a video, in time order.
struct PoseTrack: Codable {
    var duration: Double
    /// Width over height of the upright frame, so angles come out in true proportions.
    var aspect: Double
    /// How many frames were looked at, including those where nobody was found.
    var framesLooked: Int
    var samples: [PoseSample]
}

// MARK: - Geometry

enum FormGeometry {
    /// The angle at `b` between `a` and `c`, in degrees from 0 to 180.
    static func angle(_ a: JointPoint, _ b: JointPoint, _ c: JointPoint, aspect: Double) -> Double {
        let ux = (a.x - b.x) * aspect, uy = a.y - b.y
        let vx = (c.x - b.x) * aspect, vy = c.y - b.y
        let lengths = (ux * ux + uy * uy).squareRoot() * (vx * vx + vy * vy).squareRoot()
        guard lengths > 0 else { return 0 }
        let cosine = max(-1, min(1, (ux * vx + uy * vy) / lengths))
        return acos(cosine) * 180 / .pi
    }

    /// How far the line from `lower` up to `upper` tips away from straight up, in degrees:
    /// 0 is upright, 90 is level with the floor.
    static func lean(upper: JointPoint, lower: JointPoint, aspect: Double) -> Double {
        let dx = abs(upper.x - lower.x) * aspect
        let dy = lower.y - upper.y
        guard dx > 0 || dy != 0 else { return 0 }
        return atan2(dx, dy) * 180 / .pi
    }

    static func distance(_ a: JointPoint, _ b: JointPoint, aspect: Double) -> Double {
        let dx = (a.x - b.x) * aspect, dy = a.y - b.y
        return (dx * dx + dy * dy).squareRoot()
    }

    /// Which way the upper arm points, in degrees from straight down: 0 hangs down, ±90 points to
    /// either side of the picture, ±180 points straight up. Unlike `lean`, it keeps the side, so an
    /// arm swinging from behind the body to in front of it reads as the whole swing.
    static func upperArm(shoulder: JointPoint, elbow: JointPoint, aspect: Double) -> Double {
        atan2((elbow.x - shoulder.x) * aspect, elbow.y - shoulder.y) * 180 / .pi
    }

    /// `angle` moved by whole turns to within half a turn of `reference`, so angles either side of
    /// ±180 compare and average properly.
    static func unwrap(_ angle: Double, around reference: Double) -> Double {
        angle - 360 * ((angle - reference) / 360).rounded()
    }
}

// MARK: - Following the lifter

/// Picks the lifter out of everyone the phone found in a video. Each person is followed from
/// frame to frame on their own trail, so a training partner, a spotter or someone walking past
/// keeps to theirs instead of taking over the lifter's when the phone misses the lifter for a
/// moment. The lifter is the one seen the longest and looking the biggest, since the phone is set
/// up for them, and doing reps, which sets them apart from a partner waiting their turn.
enum LifterTracker {
    /// Everyone found in one frame of the video.
    struct Frame {
        var time: Double
        /// Each person's joints, keyed by `BodyJoint` raw value.
        var people: [[String: JointPoint]]
    }

    /// The box around the joints seen clearly, in frame heights, with x scaled to true proportions.
    struct Box: Equatable {
        var x: Double
        var y: Double
        /// The box's longer side, about the person's height, or their length when lying down.
        var size: Double
        /// Neck to hips, in frame heights, when seen. Unlike the box, it doesn't shrink when the
        /// person lies on a bench, sits in a machine or crouches.
        var torso: Double?

        init?(_ joints: [String: JointPoint], aspect: Double) {
            let seen = joints.values.filter { $0.confidence >= PoseSample.minimumConfidence }
            guard seen.count >= 4,
                  let minX = seen.map(\.x).min(), let maxX = seen.map(\.x).max(),
                  let minY = seen.map(\.y).min(), let maxY = seen.map(\.y).max() else { return nil }
            x = (minX + maxX) / 2 * aspect
            y = (minY + maxY) / 2
            size = max((maxX - minX) * aspect, maxY - minY)
            guard size > 0 else { return nil }
            let sample = PoseSample(time: 0, joints: joints)
            if let neck = sample.point(.neck), let root = sample.point(.root) {
                torso = FormGeometry.distance(neck, root, aspect: aspect)
            } else if let shoulder = sample.point(.leftShoulder) ?? sample.point(.rightShoulder),
                      let hip = sample.point(.leftHip) ?? sample.point(.rightHip) {
                torso = FormGeometry.distance(shoulder, hip, aspect: aspect)
            }
        }
    }

    private struct Trail {
        var samples: [PoseSample]
        var last: Box
        /// Frames in a row this person wasn't matched in.
        var misses = 0
        var sizes: [Double]
        var torsos: [Double] = []

        /// How big this person usually looks, which stays put while they crouch or bend over.
        var usualSize: Double { RepFinder.percentile(sizes, 0.5) }

        /// How far `box` is from where this trail's person was last seen, when it can be them in
        /// this frame: its middle within about half a torso of there, and not much bigger or
        /// smaller. Both allow more for each frame in a row they were missed, the distance up to
        /// about one torso. nil when it can't be them. Both boxes are drawn around only the joints
        /// seen in both frames, when there are 4 or more, so a joint the phone missed in one frame
        /// (both ankles, say) doesn't make the same person look like someone smaller.
        func distance(to joints: [String: JointPoint], box: Box, aspect: Double) -> Double? {
            var last = self.last, box = box
            let lastJoints = samples[samples.count - 1].joints
            func seen(_ j: [String: JointPoint]) -> Set<String> { Set(j.filter { $0.value.confidence >= PoseSample.minimumConfidence }.keys) }
            let shared = seen(lastJoints).intersection(seen(joints))
            if let a = Box(lastJoints.filter { shared.contains($0.key) }, aspect: aspect),
               let b = Box(joints.filter { shared.contains($0.key) }, aspect: aspect) {
                last = a
                box = b
            }
            let reach = max(last.size, usualSize) * min(0.2 + 0.05 * Double(misses), 0.35)
            let d = ((box.x - last.x) * (box.x - last.x) + (box.y - last.y) * (box.y - last.y)).squareRoot()
            let change = min(1.5 + 0.1 * Double(misses), 2.5)
            let ratio = box.size / last.size
            guard d <= reach, ratio >= 1 / change, ratio <= change else { return nil }
            return d
        }

        /// How big this person looks standing tall, or lying at full length.
        var fullSize: Double { RepFinder.percentile(sizes, 0.9) }

        /// How big this person would look standing tall: at least 2.8 torso lengths, about
        /// nose to ankles. Someone lying on a bench, sitting in a machine or at a preacher pad
        /// then counts as big as someone standing beside them at the same distance.
        var bodySize: Double { max(fullSize, 2.8 * RepFinder.percentile(torsos, 0.5)) }

        /// How far this person's joints go up and down, as a share of their full size, up to 1.
        /// The lifter's reps show up here, while someone standing by or walking past barely moves
        /// up or down.
        var motion: Double {
            var heights: [String: [Double]] = [:]
            for sample in samples {
                for (name, point) in sample.joints where point.confidence >= PoseSample.minimumConfidence {
                    heights[name, default: []].append(point.y)
                }
            }
            let ranges = heights.values.filter { $0.count >= 8 }.map { RepFinder.percentile($0, 0.9) - RepFinder.percentile($0, 0.1) }
            guard let most = ranges.max(), bodySize > 0 else { return 0 }
            return min(most / bodySize, 1)
        }

        var score: Double { Double(samples.count) * bodySize * (1 + motion) }
    }

    /// The lifter's pose in each frame they were found in, in time order.
    static func lifter(in frames: [Frame], aspect: Double) -> [PoseSample] {
        var trails: [Trail] = []
        for frame in frames {
            let people = frame.people.compactMap { joints in Box(joints, aspect: aspect).map { (joints: joints, box: $0) } }
            // Closest pairs first, so each person goes to the trail that fits them best.
            var pairs: [(distance: Double, trail: Int, person: Int)] = []
            for (t, trail) in trails.enumerated() {
                for (p, person) in people.enumerated() {
                    if let d = trail.distance(to: person.joints, box: person.box, aspect: aspect) { pairs.append((d, t, p)) }
                }
            }
            pairs.sort { $0.distance < $1.distance }
            var matchedTrails = Set<Int>(), matchedPeople = Set<Int>()
            for pair in pairs where !matchedTrails.contains(pair.trail) && !matchedPeople.contains(pair.person) {
                matchedTrails.insert(pair.trail)
                matchedPeople.insert(pair.person)
                let person = people[pair.person]
                trails[pair.trail].samples.append(PoseSample(time: frame.time, joints: person.joints))
                trails[pair.trail].last = person.box
                trails[pair.trail].misses = 0
                trails[pair.trail].sizes.append(person.box.size)
                if let torso = person.box.torso { trails[pair.trail].torsos.append(torso) }
            }
            for t in trails.indices where !matchedTrails.contains(t) {
                trails[t].misses += 1
            }
            for (p, person) in people.enumerated() where !matchedPeople.contains(p) {
                trails.append(Trail(samples: [PoseSample(time: frame.time, joints: person.joints)], last: person.box, sizes: [person.box.size],
                                    torsos: person.box.torso.map { [$0] } ?? []))
            }
        }
        let scores = trails.map(\.score)
        return scores.indices.max { scores[$0] < scores[$1] }.map { trails[$0].samples } ?? []
    }
}

// MARK: - Kinds of lift

/// What the phone watches to find the reps.
enum RepSignal: String, Codable, CaseIterable {
    case hipHeight
    case wristHeight
    case kneeAngle
    case elbowAngle

    /// Which sides to try. nil means both sides together.
    var sideOptions: [BodySide?] {
        switch self {
        case .hipHeight: return [nil]
        case .wristHeight: return [nil, .left, .right]
        case .kneeAngle, .elbowAngle: return [.left, .right]
        }
    }

    /// The smallest swing that counts as movement: heights in torso lengths, angles in degrees.
    var minimumSwing: Double {
        switch self {
        case .hipHeight: return 0.08
        case .wristHeight: return 0.2
        case .kneeAngle: return 20
        case .elbowAngle: return 25
        }
    }
}

/// The kind of movement, which decides how reps are found and what gets measured.
enum LiftPattern: String, Codable, CaseIterable {
    case squat
    case hinge
    case benchPress
    case overheadPress
    case row
    case curl
    case tricepsExtension
    case legPress
    case calfRaise
    case other

    static func of(name: String, category: ExerciseCategory, equipment: Equipment) -> LiftPattern {
        let n = name.lowercased()
        func has(_ words: String...) -> Bool { words.contains { n.contains($0) } }
        if has("leg press") { return .legPress }
        if has("calf") { return .calfRaise }
        if has("leg curl", "hamstring curl", "leg extension") { return .other }
        if has("deadlift", "rdl", "romanian", "good morning", "rack pull", "back extension", "hyperextension") { return .hinge }
        if has("squat", "lunge") { return .squat }
        if has("military", "overhead", "ohp", "shoulder press", "push press", "arnold") { return .overheadPress }
        if has("bench", "incline", "decline", "chest press", "floor press") { return .benchPress }
        if has("row") { return .row }
        if has("tricep", "skull", "kickback", "pushdown", "extension") { return .tricepsExtension }
        if has("curl") { return .curl }
        if has("press") {
            switch category {
            case .shoulders: return .overheadPress
            case .legs: return .legPress
            default: return .benchPress
            }
        }
        return .other
    }

    var signal: RepSignal {
        switch self {
        case .squat, .calfRaise, .other: return .hipHeight
        case .hinge, .benchPress, .overheadPress, .row: return .wristHeight
        case .curl, .tricepsExtension: return .elbowAngle
        case .legPress: return .kneeAngle
        }
    }

    /// Whether a rep is counted at the high point of the signal (top, or a straight arm or leg)
    /// rather than at the low point.
    var countsAtHigh: Bool {
        switch self {
        case .hinge, .overheadPress, .row, .calfRaise: return true
        case .squat, .benchPress, .curl, .tricepsExtension, .legPress, .other: return false
        }
    }

    /// What the counted point of a rep is called.
    var turnName: String {
        switch self {
        case .squat, .legPress: return "bottom"
        case .benchPress: return "bar at chest"
        case .hinge, .overheadPress: return "lockout"
        case .row: return "top of pull"
        case .curl: return "top of curl"
        case .tricepsExtension: return "deepest stretch"
        case .calfRaise: return "top"
        case .other: return "turnaround"
        }
    }

    /// Whether the first half of a rep (start to the counted point) is the lowering half.
    var lowersFirst: Bool {
        switch self {
        case .squat, .benchPress, .tricepsExtension, .legPress, .other: return true
        case .hinge, .overheadPress, .row, .curl, .calfRaise: return false
        }
    }

    /// Words for the two halves of a rep, in order.
    var halfWords: (first: String, second: String) {
        lowersFirst ? ("down", "up") : ("up", "down")
    }
}

enum CameraAngle: String, Codable {
    case side, front, angled, unknown

    var phrase: String {
        switch self {
        case .side: return "side view"
        case .front: return "front or back view"
        case .angled: return "angled view"
        case .unknown: return "couldn't tell"
        }
    }
}

// MARK: - Measurements

/// What the phone measured for one rep. Angles are in degrees, and are 2D estimates.
struct RepMeasure: Codable, Hashable {
    var number: Int
    var startTime: Double
    var turnTime: Double
    var endTime: Double

    // At the counted point of the rep. nil when the joints weren't visible.
    var kneeAtTurn: Double?
    var hipAtTurn: Double?
    var elbowAtTurn: Double?
    var leanAtTurn: Double?
    /// How far the hips are below the knees at the counted point, as a share of thigh length.
    /// Positive means below.
    var hipBelowKnee: Double?

    // Over the whole rep.
    var kneeMin: Double?
    var kneeMax: Double?
    var elbowMin: Double?
    var elbowMax: Double?
    var leanMin: Double?
    var leanMax: Double?
    /// How far the hands travelled side to side in the picture, in torso lengths.
    var barDrift: Double?
    /// How much the upper arm's angle changed, in degrees (curls and extensions).
    var upperArmSwing: Double?
    /// How far the hips rose, as a share of shin length (calf raises).
    var riseShare: Double?
    /// Change in torso lean over the first third of the pull (deadlifts). Positive means the torso
    /// tipped further over, so the hips rose before the chest.
    var earlyLeanChange: Double?

    init(number: Int, startTime: Double, turnTime: Double, endTime: Double) {
        self.number = number
        self.startTime = startTime
        self.turnTime = turnTime
        self.endTime = endTime
    }
}

/// Everything the phone measured in one video.
struct FormMeasurements: Codable, Hashable {
    var pattern: LiftPattern
    var signal: RepSignal
    var side: BodySide
    var camera: CameraAngle
    /// Share of the frames looked at in which the lifter was found.
    var trackedShare: Double
    var reps: [RepMeasure]
}

/// A frame shown to Claude and in the app, with the pose found in it.
struct FormKeyFrame: Codable, Hashable {
    /// 1-based, in time order. This is the number Claude refers to.
    var number: Int
    var time: Double
    var label: String
    var pose: PoseSample?
}

// MARK: - Finding reps

struct SignalTurn: Equatable {
    var index: Int
    var isHigh: Bool
    /// False for the last extreme, which the signal never came back from.
    var confirmed: Bool
}

/// One rep, as indexes into a signal: where it starts, where it turns, where it ends.
struct RepSpan: Equatable {
    var start: Int
    var turn: Int
    var end: Int
    /// The turning points either side, before any pause around the rep was trimmed off.
    var outerStart: Int
    var outerEnd: Int

    init(start: Int, turn: Int, end: Int) {
        self.start = start
        self.turn = turn
        self.end = end
        outerStart = start
        outerEnd = end
    }
}

enum RepFinder {
    /// Centered moving average over `window` samples.
    static func smooth(_ values: [Double], window: Int) -> [Double] {
        guard window > 1, values.count > 2 else { return values }
        let half = window / 2
        return values.indices.map { i in
            let lo = max(0, i - half), hi = min(values.count - 1, i + half)
            let slice = values[lo...hi]
            return slice.reduce(0, +) / Double(slice.count)
        }
    }

    /// The value below which `fraction` of the values fall.
    static func percentile(_ values: [Double], _ fraction: Double) -> Double {
        guard !values.isEmpty else { return 0 }
        let sorted = values.sorted()
        let position = max(0, min(1, fraction)) * Double(sorted.count - 1)
        let lower = Int(position.rounded(.down))
        let upper = min(sorted.count - 1, lower + 1)
        let weight = position - Double(lower)
        return sorted[lower] * (1 - weight) + sorted[upper] * weight
    }

    /// The peaks and valleys of a wave. Each one counts once the signal has come back from it by at
    /// least `threshold`. The last extreme is included unconfirmed, so the final rep has an end.
    static func turns(_ v: [Double], threshold: Double) -> [SignalTurn] {
        guard v.count >= 2, threshold > 0 else { return [] }
        var result: [SignalTurn] = []
        var direction = 0
        var minIndex = 0, maxIndex = 0, extreme = 0
        for i in 1..<v.count {
            switch direction {
            case 0:
                if v[i] < v[minIndex] { minIndex = i }
                if v[i] > v[maxIndex] { maxIndex = i }
                if v[maxIndex] - v[i] >= threshold {
                    result.append(SignalTurn(index: maxIndex, isHigh: true, confirmed: true))
                    direction = -1
                    extreme = i
                } else if v[i] - v[minIndex] >= threshold {
                    result.append(SignalTurn(index: minIndex, isHigh: false, confirmed: true))
                    direction = 1
                    extreme = i
                }
            case 1:
                if v[i] > v[extreme] {
                    extreme = i
                } else if v[extreme] - v[i] >= threshold {
                    result.append(SignalTurn(index: extreme, isHigh: true, confirmed: true))
                    direction = -1
                    extreme = i
                }
            default:
                if v[i] < v[extreme] {
                    extreme = i
                } else if v[i] - v[extreme] >= threshold {
                    result.append(SignalTurn(index: extreme, isHigh: false, confirmed: true))
                    direction = 1
                    extreme = i
                }
            }
        }
        if direction != 0 {
            result.append(SignalTurn(index: extreme, isHigh: direction == 1, confirmed: false))
        }
        return result
    }

    /// The reps in a wave, counted at its peaks (`countAtHigh`) or at its valleys.
    static func spans(_ v: [Double], countAtHigh: Bool, threshold: Double) -> [RepSpan] {
        let t = turns(v, threshold: threshold)
        var result: [RepSpan] = []
        for (k, turn) in t.enumerated() where turn.confirmed && turn.isHigh == countAtHigh {
            let start: Int
            if k > 0 {
                start = t[k - 1].index
            } else {
                // The video began on the way into this rep: start from the opposite extreme before it.
                let before = Array(v[0...turn.index])
                guard let opposite = countAtHigh ? before.indices.min(by: { before[$0] < before[$1] })
                                                 : before.indices.max(by: { before[$0] < before[$1] }),
                      abs(v[turn.index] - v[opposite]) >= threshold else { continue }
                start = opposite
            }
            let end = k + 1 < t.count ? t[k + 1].index : v.count - 1
            result.append(tighten(RepSpan(start: start, turn: turn.index, end: end), v))
        }
        return result
    }

    /// Moves a rep's start up to the moment it really gets going, and its end back to the moment it
    /// settles, so a pause or a noisy wobble before or after the rep isn't counted as part of it.
    /// That is the last moment before the turn, and the first after it, still within `band` of the
    /// whole swing from where the rep started or ended.
    static func tighten(_ span: RepSpan, _ v: [Double], band: Double = 0.05) -> RepSpan {
        var result = span
        let startTolerance = abs(v[span.start] - v[span.turn]) * band
        for i in stride(from: span.turn - 1, through: span.start, by: -1) where abs(v[i] - v[span.start]) <= startTolerance {
            result.start = i
            break
        }
        let endTolerance = abs(v[span.end] - v[span.turn]) * band
        for i in stride(from: span.turn + 1, through: span.end, by: 1) where abs(v[i] - v[span.end]) <= endTolerance {
            result.end = i
            break
        }
        return result
    }

    /// Joins reps whose turns are too close together to be two reps, which happens when the phone
    /// sees one turn twice, for example after mixing up the left and right arm for a frame or two.
    /// Too close is under 0.75 s, or under 40% of the set's usual time between turns when that is
    /// longer, but never over 70% of it, so the reps of a fast set aren't joined. The joined rep
    /// keeps the more extreme turn and runs to the later rep's end. `times` are the seconds of `v`.
    static func merge(_ spans: [RepSpan], _ v: [Double], times: [Double], countAtHigh: Bool) -> [RepSpan] {
        let gaps = zip(spans, spans.dropFirst()).map { times[$1.turn] - times[$0.turn] }
        var window = 0.75
        if gaps.count >= 3 {
            let usual = percentile(gaps, 0.5)
            window = min(max(0.75, 0.4 * usual), 0.7 * usual)
        }
        var kept: [RepSpan] = []
        // When the first turn of a joined rep was seen. Measuring from it, not from the kept turn,
        // keeps the next real rep from being joined on too when the later turn is the one kept.
        var firstTurnTime = -Double.infinity
        for span in spans {
            if var last = kept.last, times[span.turn] - firstTurnTime < window {
                if countAtHigh ? v[span.turn] > v[last.turn] : v[span.turn] < v[last.turn] {
                    last.turn = span.turn
                }
                last.end = span.end
                last.outerEnd = span.outerEnd
                kept[kept.count - 1] = last
                continue
            }
            kept.append(span)
            firstTurnTime = times[span.turn]
        }
        return kept
    }

    /// When a clip starts with the walk-out or ends with the re-rack, the first rep's start and the
    /// last rep's end sit back at the rack, so the walking would count as part of those reps. With
    /// at least three reps, this moves them to the level where the reps in between start and end:
    /// the last moment before the turn, and the first after it, still 95% of that swing away from
    /// the turn. The first rep's first half is then capped at 1.5 times the usual first half, and
    /// the last rep's second half likewise when it is the lowering. A slow last lift is left alone,
    /// since a grinding last rep is real. `times` are the seconds of `v`.
    static func trimEdges(_ spans: [RepSpan], _ v: [Double], times: [Double], lowersFirst: Bool) -> [RepSpan] {
        guard spans.count >= 3 else { return spans }
        var result = spans
        let others = (first: spans.dropFirst(), last: spans.dropLast())
        let firstHalf = percentile(others.first.map { times[$0.turn] - times[$0.start] }, 0.5)
        let secondHalf = percentile(others.last.map { times[$0.end] - times[$0.turn] }, 0.5)
        let startLevel = percentile(others.first.map { v[$0.start] }, 0.5)
        let endLevel = percentile(others.last.map { v[$0.end] }, 0.5)

        var first = spans[0]
        let rise = abs(startLevel - v[first.turn]) * 0.95
        if let i = stride(from: first.turn - 1, through: first.start, by: -1).first(where: { abs(v[$0] - v[first.turn]) >= rise }) {
            first.start = i
        }
        while first.start + 1 < first.turn, times[first.turn] - times[first.start] > 1.5 * firstHalf {
            first.start += 1
        }
        result[0] = first

        var last = spans[spans.count - 1]
        let fall = abs(endLevel - v[last.turn]) * 0.95
        if let i = stride(from: last.turn + 1, through: last.end, by: 1).first(where: { abs(v[$0] - v[last.turn]) >= fall }) {
            last.end = i
        }
        if !lowersFirst {
            while last.end - 1 > last.turn, times[last.end] - times[last.turn] > 1.5 * secondHalf {
                last.end -= 1
            }
        }
        result[result.count - 1] = last
        return result
    }
}

// MARK: - Measuring

enum FormAnalyzer {
    /// Finds the reps in a tracked video and measures each one. nil when the lifter wasn't found
    /// in enough frames, or nothing moved enough to count.
    static func measure(track: PoseTrack, pattern: LiftPattern) -> FormMeasurements? {
        let samples = track.samples
        guard samples.count >= 6 else { return nil }
        let torso = torsoLength(track)
        let camera = cameraAngle(track, torso: torso)
        let seenBetter = dominantSide(track)
        let signals: [RepSignal] = pattern == .other ? RepSignal.allCases : [pattern.signal]

        // Use the signal and side that move the most, compared with what counts as movement. The
        // side the camera sees better wins unless the other moves at least 1.5 times as much: the
        // hidden side is found less surely, and that jitter alone widens its range. From the front
        // or back, neither side is hidden.
        var best: (signal: RepSignal, side: BodySide?, indices: [Int], values: [Double], range: Double, score: Double, rank: Double)?
        for signal in signals {
            for side in signal.sideOptions {
                let s = series(signal, side: side, track: track, torso: torso)
                guard s.values.count >= max(6, samples.count * 4 / 10) else { continue }
                let smoothed = RepFinder.smooth(s.values, window: smoothingWindow(s.indices, samples: samples))
                let range = RepFinder.percentile(smoothed, 0.95) - RepFinder.percentile(smoothed, 0.05)
                let score = range / signal.minimumSwing
                let hidden = side != nil && side != seenBetter && camera != .front
                let rank = hidden ? score / 1.5 : score
                if let current = best, current.rank >= rank { continue }
                best = (signal, side, s.indices, smoothed, range, score, rank)
            }
        }
        guard let chosen = best else { return nil }
        let side = chosen.side ?? seenBetter

        var spans: [RepSpan] = []
        if chosen.score >= 1 {
            let times = chosen.indices.map { samples[$0].time }
            spans = RepFinder.spans(chosen.values, countAtHigh: pattern.countsAtHigh, threshold: chosen.range * 0.35)
            spans = RepFinder.merge(spans, chosen.values, times: times, countAtHigh: pattern.countsAtHigh)
            spans = RepFinder.trimEdges(spans, chosen.values, times: times, lowersFirst: pattern.lowersFirst)
            spans = dropOddEnds(spans, indices: chosen.indices, track: track, pattern: pattern, side: side, torso: torso, camera: camera)
        }

        let reps = spans.enumerated().map { k, span in
            measureRep(number: k + 1, span: span, indices: chosen.indices, track: track, pattern: pattern, side: side, torso: torso)
        }
        return FormMeasurements(
            pattern: pattern,
            signal: chosen.signal,
            side: side,
            camera: camera,
            trackedShare: Double(samples.count) / Double(max(track.framesLooked, samples.count, 1)),
            reps: reps
        )
    }

    /// Drops a first or last "rep" that doesn't look like the reps in between, which is usually
    /// the setup or the finish: picking the bar up off the floor before rows, getting up after leg
    /// presses or bench, or lifting the hands off the lap onto the preacher pad. Only with at least
    /// three reps, and only from the ends. A rep is dropped when, compared with the middle of the
    /// others, the torso lean at its turn differs by over 35°, the working joint's angle there by
    /// over 50°, the hips travel over 0.6 torso lengths further from its start to its end, or, on
    /// curls and extensions, the upper arm starts over 25° away. Angles mean nothing from the
    /// front or back, so only the hips' travel counts there.
    private static func dropOddEnds(_ spans: [RepSpan], indices: [Int], track: PoseTrack, pattern: LiftPattern, side: BodySide, torso: Double, camera: CameraAngle) -> [RepSpan] {
        let samples = track.samples, aspect = track.aspect
        let anglesCount = camera != .front
        let usesArms: Bool
        switch pattern {
        case .benchPress, .overheadPress, .row, .curl, .tricepsExtension: usesArms = true
        case .squat, .hinge, .legPress, .calfRaise, .other: usesArms = false
        }
        let armMatters = pattern == .curl || pattern == .tricepsExtension

        struct Look { var lean: Double?, joint: Double?, travel: Double?, arm: Double? }
        func look(_ span: RepSpan) -> Look {
            let start = samples[indices[span.start]], turn = samples[indices[span.turn]], end = samples[indices[span.end]]
            var look = Look()
            if anglesCount {
                look.lean = torsoLean(turn, side: side, aspect: aspect)
                look.joint = usesArms ? jointAngle(turn, side.shoulder, side.elbow, side.wrist, aspect: aspect)
                                      : jointAngle(turn, side.hip, side.knee, side.ankle, aspect: aspect)
                if armMatters, let shoulder = start.point(side.shoulder), let elbow = start.point(side.elbow) {
                    look.arm = FormGeometry.upperArm(shoulder: shoulder, elbow: elbow, aspect: aspect)
                }
            }
            if let a = start.point(.root) ?? start.point(side.hip), let b = end.point(.root) ?? end.point(side.hip) {
                look.travel = FormGeometry.distance(a, b, aspect: aspect) / torso
            }
            return look
        }
        func middle(_ values: [Double]) -> Double? { values.isEmpty ? nil : RepFinder.percentile(values, 0.5) }
        func odd(_ span: RepSpan, among others: [RepSpan]) -> Bool {
            let mine = look(span), theirs = others.map(look)
            if let lean = mine.lean, let usual = middle(theirs.compactMap(\.lean)), abs(lean - usual) > 35 { return true }
            if let joint = mine.joint, let usual = middle(theirs.compactMap(\.joint)), abs(joint - usual) > 50 { return true }
            let arms = theirs.compactMap(\.arm)
            if let arm = mine.arm, let reference = arms.first,
               let usual = middle(arms.map { FormGeometry.unwrap($0, around: reference) }),
               abs(FormGeometry.unwrap(arm, around: usual) - usual) > 25 { return true }
            if let travel = mine.travel, let usual = middle(theirs.compactMap(\.travel)), travel - usual > 0.6 { return true }
            return false
        }

        // With one or two spans there are no reps in between to compare with. A rep ends in the
        // posture it started in, which sitting up, standing up or getting off the sled doesn't.
        func shiftsLean(_ span: RepSpan) -> Bool {
            guard anglesCount else { return false }
            let leans = (span.start...span.end).compactMap { torsoLean(samples[indices[$0]], side: side, aspect: aspect) }
            guard let first = leans.first, let last = leans.last else { return false }
            return abs(first - last) > 35
        }
        // Lifting the arms from the lap onto the pad moves the upper arm on the way to the turn. So
        // does a swinging cheat curl, so this only picks which of two unlike spans is the setup.
        func armMoves(_ span: RepSpan) -> Bool {
            guard let s0 = samples[indices[span.start]].point(side.shoulder), let e0 = samples[indices[span.start]].point(side.elbow),
                  let s1 = samples[indices[span.turn]].point(side.shoulder), let e1 = samples[indices[span.turn]].point(side.elbow) else { return false }
            let a = FormGeometry.upperArm(shoulder: s0, elbow: e0, aspect: aspect)
            let b = FormGeometry.upperArm(shoulder: s1, elbow: e1, aspect: aspect)
            return abs(FormGeometry.unwrap(a, around: b) - b) > 25
        }
        if spans.count < 3 {
            let kept = spans.filter { !shiftsLean($0) }
            guard kept.count == 2, anglesCount, armMatters,
                  odd(kept[0], among: [kept[1]]) || odd(kept[1], among: [kept[0]]) else { return kept }
            let moves = kept.map(armMoves)
            return moves[0] == moves[1] ? kept : [moves[0] ? kept[1] : kept[0]]
        }

        // Each end is judged against the spans between the ends, and also against the other end
        // when that one looks like a rep, so a setup at one end can't pull the middle off and get
        // a real rep at the other end dropped. Both ends are judged before either is removed.
        var result = spans
        while result.count >= 3 {
            let first = result[0], last = result[result.count - 1], inner = Array(result[1..<(result.count - 1)])
            let firstOdd = odd(first, among: inner), lastOdd = odd(last, among: inner)
            let dropFirst = firstOdd && (lastOdd || odd(first, among: inner + [last]))
            let dropLast = lastOdd && (firstOdd || odd(last, among: [first] + inner))
            guard dropFirst || dropLast else { break }
            if dropLast { result.removeLast() }
            if dropFirst { result.removeFirst() }
        }
        return result
    }

    /// Typical distance from neck to hips, the yardstick for heights and drift.
    static func torsoLength(_ track: PoseTrack) -> Double {
        var lengths: [Double] = []
        for s in track.samples {
            if let neck = s.point(.neck), let root = s.point(.root) {
                lengths.append(FormGeometry.distance(neck, root, aspect: track.aspect))
                continue
            }
            for side in BodySide.allCases {
                if let shoulder = s.point(side.shoulder), let hip = s.point(side.hip) {
                    lengths.append(FormGeometry.distance(shoulder, hip, aspect: track.aspect))
                    break
                }
            }
        }
        let median = RepFinder.percentile(lengths, 0.5)
        return median > 0.02 ? median : 0.3
    }

    private static func smoothingWindow(_ indices: [Int], samples: [PoseSample]) -> Int {
        guard indices.count > 2 else { return 1 }
        let steps = zip(indices, indices.dropFirst()).map { samples[$0.1].time - samples[$0.0].time }.sorted()
        let step = max(steps[steps.count / 2], 0.01)
        let window = Int((0.3 / step).rounded())
        return max(1, window | 1)
    }

    private static func series(_ signal: RepSignal, side: BodySide?, track: PoseTrack, torso: Double) -> (indices: [Int], values: [Double]) {
        var indices: [Int] = []
        var values: [Double] = []
        for (i, s) in track.samples.enumerated() {
            if let v = value(signal, side: side, sample: s, aspect: track.aspect, torso: torso) {
                indices.append(i)
                values.append(v)
            }
        }
        return (indices, values)
    }

    private static func value(_ signal: RepSignal, side: BodySide?, sample s: PoseSample, aspect: Double, torso: Double) -> Double? {
        switch signal {
        case .hipHeight:
            if let root = s.point(.root) { return (1 - root.y) / torso }
            return height(of: [s.point(.leftHip), s.point(.rightHip)], torso: torso)
        case .wristHeight:
            if let side { return height(of: [s.point(side.wrist)], torso: torso) }
            return height(of: [s.point(.leftWrist), s.point(.rightWrist)], torso: torso)
        case .kneeAngle:
            guard let side, let hip = s.point(side.hip), let knee = s.point(side.knee), let ankle = s.point(side.ankle) else { return nil }
            return FormGeometry.angle(hip, knee, ankle, aspect: aspect)
        case .elbowAngle:
            guard let side, let shoulder = s.point(side.shoulder), let elbow = s.point(side.elbow), let wrist = s.point(side.wrist) else { return nil }
            return FormGeometry.angle(shoulder, elbow, wrist, aspect: aspect)
        }
    }

    /// Average height of the points that were found, in torso lengths up from the bottom of the frame.
    private static func height(of points: [JointPoint?], torso: Double) -> Double? {
        let found = points.compactMap { $0 }
        guard !found.isEmpty else { return nil }
        return (1 - found.map(\.y).reduce(0, +) / Double(found.count)) / torso
    }

    /// The side the camera sees better.
    private static func dominantSide(_ track: PoseTrack) -> BodySide {
        func total(_ side: BodySide) -> Double {
            let joints = [side.shoulder, side.elbow, side.wrist, side.hip, side.knee, side.ankle]
            return track.samples.reduce(0) { sum, s in
                sum + joints.reduce(0) { $0 + (s.joints[$1.rawValue]?.confidence ?? 0) }
            }
        }
        return total(.left) >= total(.right) ? .left : .right
    }

    private static func cameraAngle(_ track: PoseTrack, torso: Double) -> CameraAngle {
        let ratios = track.samples.compactMap { s -> Double? in
            guard let l = s.point(.leftShoulder), let r = s.point(.rightShoulder) else { return nil }
            return FormGeometry.distance(l, r, aspect: track.aspect) / torso
        }
        guard ratios.count >= 3 else { return .unknown }
        let m = RepFinder.percentile(ratios, 0.5)
        if m < 0.35 { return .side }
        if m > 0.6 { return .front }
        return .angled
    }

    private static func torsoLean(_ s: PoseSample, side: BodySide, aspect: Double) -> Double? {
        if let neck = s.point(.neck), let root = s.point(.root) {
            return FormGeometry.lean(upper: neck, lower: root, aspect: aspect)
        }
        if let shoulder = s.point(side.shoulder), let hip = s.point(side.hip) {
            return FormGeometry.lean(upper: shoulder, lower: hip, aspect: aspect)
        }
        return nil
    }

    private static func jointAngle(_ s: PoseSample, _ a: BodyJoint, _ b: BodyJoint, _ c: BodyJoint, aspect: Double) -> Double? {
        guard let pa = s.point(a), let pb = s.point(b), let pc = s.point(c) else { return nil }
        return FormGeometry.angle(pa, pb, pc, aspect: aspect)
    }

    /// The lowest and highest of a rep's per-frame values, after averaging each with its
    /// neighbours, so one jittery frame doesn't set the number.
    static func extent(_ values: [Double]) -> (low: Double, high: Double)? {
        guard values.count >= 2 else { return nil }
        let smoothed = RepFinder.smooth(values, window: 3)
        guard let low = smoothed.min(), let high = smoothed.max() else { return nil }
        return (low, high)
    }

    private static func measureRep(number: Int, span: RepSpan, indices: [Int], track: PoseTrack, pattern: LiftPattern, side: BodySide, torso: Double) -> RepMeasure {
        let samples = track.samples
        let aspect = track.aspect
        let startIndex = indices[span.start], turnIndex = indices[span.turn], endIndex = indices[span.end]
        // Ranges are measured a little past the trimmed start and end, so the very top and bottom
        // of the movement are in, but a long pause or the walk-out isn't.
        let reach = 0.3
        let from = samples[indices[span.outerStart]...startIndex].firstIndex { $0.time >= samples[startIndex].time - reach } ?? startIndex
        let to = samples[endIndex...indices[span.outerEnd]].lastIndex { $0.time <= samples[endIndex].time + reach } ?? endIndex
        let window = Array(samples[from...to])
        let turn = samples[turnIndex]
        var rep = RepMeasure(number: number, startTime: samples[startIndex].time, turnTime: turn.time, endTime: samples[endIndex].time)

        func knee(_ s: PoseSample) -> Double? { jointAngle(s, side.hip, side.knee, side.ankle, aspect: aspect) }
        func hip(_ s: PoseSample) -> Double? { jointAngle(s, side.shoulder, side.hip, side.knee, aspect: aspect) }
        func elbow(_ s: PoseSample) -> Double? { jointAngle(s, side.shoulder, side.elbow, side.wrist, aspect: aspect) }
        func lean(_ s: PoseSample) -> Double? { torsoLean(s, side: side, aspect: aspect) }

        rep.kneeAtTurn = knee(turn)
        rep.hipAtTurn = hip(turn)
        rep.elbowAtTurn = elbow(turn)
        rep.leanAtTurn = lean(turn)
        if let knees = extent(window.compactMap(knee)) {
            rep.kneeMin = knees.low
            rep.kneeMax = knees.high
        }
        if let elbows = extent(window.compactMap(elbow)) {
            rep.elbowMin = elbows.low
            rep.elbowMax = elbows.high
        }
        if let leans = extent(window.compactMap(lean)) {
            rep.leanMin = leans.low
            rep.leanMax = leans.high
        }

        if let hipPoint = turn.point(side.hip) ?? turn.point(.root), let kneePoint = turn.point(side.knee) {
            let thigh = FormGeometry.distance(hipPoint, kneePoint, aspect: aspect)
            if thigh > 0.01 { rep.hipBelowKnee = (hipPoint.y - kneePoint.y) / thigh }
        }

        // Bar drift follows one wrist the whole rep. Averaging both wrists only when both are seen
        // would make the hand position jump by half the grip width each time the far one is lost.
        var handXs = window.compactMap { $0.point(side.wrist)?.x }
        if handXs.count < 3 { handXs = window.compactMap { $0.point(side.other.wrist)?.x } }
        if handXs.count >= 3, let hands = extent(handXs) {
            rep.barDrift = (hands.high - hands.low) * aspect / torso
        }

        // Keeps the side the arm points to, so a swing from behind the body to in front of it
        // reads as the whole swing. Unwrapped around the first frame for arms pointing up.
        let arm = window.compactMap { s -> Double? in
            guard let shoulder = s.point(side.shoulder), let elbowPoint = s.point(side.elbow) else { return nil }
            return FormGeometry.upperArm(shoulder: shoulder, elbow: elbowPoint, aspect: aspect)
        }
        if arm.count >= 3, let swing = extent(arm.map { FormGeometry.unwrap($0, around: arm[0]) }) {
            rep.upperArmSwing = swing.high - swing.low
        }

        let hipYs = window.compactMap { s in (s.point(.root) ?? s.point(side.hip))?.y }
        let shins = window.compactMap { s -> Double? in
            guard let k = s.point(side.knee), let a = s.point(side.ankle) else { return nil }
            return FormGeometry.distance(k, a, aspect: aspect)
        }
        if hipYs.count >= 3, let hips = extent(hipYs), !shins.isEmpty {
            let shin = RepFinder.percentile(shins, 0.5)
            if shin > 0.01 { rep.riseShare = (hips.high - hips.low) / shin }
        }

        if pattern == .hinge, let leanStart = lean(samples[startIndex]) {
            let target = rep.startTime + (rep.turnTime - rep.startTime) / 3
            if let third = window.min(by: { abs($0.time - target) < abs($1.time - target) }), let leanThird = lean(third) {
                rep.earlyLeanChange = leanThird - leanStart
            }
        }
        return rep
    }

    // MARK: Key frames

    /// The frames to show Claude: the start, the turn of each chosen rep, the way into and out of
    /// the first and last chosen reps, and the finish. Evenly spaced frames when no reps were found.
    static func keyFrames(track: PoseTrack, measurements: FormMeasurements?, maxFrames: Int = 10) -> [FormKeyFrame] {
        var picks: [(time: Double, label: String, priority: Int)] = []
        if let m = measurements, !m.reps.isEmpty {
            let pattern = m.pattern
            let words = pattern.halfWords
            let chosen = chooseReps(count: m.reps.count, limit: 4).map { m.reps[$0] }
            picks.append((m.reps[0].startTime, "start of rep 1", 1))
            for (k, rep) in chosen.enumerated() {
                let edge = k == 0 || k == chosen.count - 1
                if edge { picks.append(((rep.startTime + rep.turnTime) / 2, "rep \(rep.number), on the way \(words.first)", 0)) }
                picks.append((rep.turnTime, "rep \(rep.number), \(pattern.turnName)", 2))
                if edge { picks.append(((rep.turnTime + rep.endTime) / 2, "rep \(rep.number), on the way \(words.second)", 0)) }
            }
            if let last = chosen.last { picks.append((last.endTime, "end of rep \(last.number)", 1)) }
        }
        if picks.isEmpty, track.duration > 0 {
            let count = max(4, min(maxFrames, Int(track.duration / 1.5)))
            for i in 0..<count {
                let t = (Double(i) + 0.5) * track.duration / Double(count)
                picks.append((t, String(format: "%.1f s into the video", t), 1))
            }
        }

        // Use the tracked frame nearest each pick, so the pose drawn on it matches.
        var frames: [(time: Double, label: String, priority: Int, pose: PoseSample?)] = picks.map { pick in
            let nearest = track.samples.min { abs($0.time - pick.time) < abs($1.time - pick.time) }
            if let nearest, abs(nearest.time - pick.time) <= 0.25 {
                return (nearest.time, pick.label, pick.priority, nearest)
            }
            return (pick.time, pick.label, pick.priority, nil)
        }
        frames.sort { $0.time < $1.time }

        var unique: [(time: Double, label: String, priority: Int, pose: PoseSample?)] = []
        for frame in frames {
            if let last = unique.last, frame.time - last.time < 0.1 {
                if frame.priority > last.priority { unique[unique.count - 1] = frame }
                continue
            }
            unique.append(frame)
        }
        while unique.count > maxFrames, let drop = unique.indices.min(by: { unique[$0].priority < unique[$1].priority }) {
            unique.remove(at: drop)
        }
        return unique.enumerated().map { i, f in
            FormKeyFrame(number: i + 1, time: f.time, label: f.label, pose: f.pose)
        }
    }

    /// Indexes of up to `limit` reps spread over the set, always including the first and last.
    static func chooseReps(count: Int, limit: Int) -> [Int] {
        guard count > limit, limit > 1 else { return Array(0..<count) }
        let picked = (0..<limit).map { Int((Double($0) * Double(count - 1) / Double(limit - 1)).rounded()) }
        return Array(Set(picked)).sorted()
    }
}

// MARK: - Measurements in words

enum FormReport {
    static func lines(_ m: FormMeasurements, loggedReps: Int) -> [String] {
        var lines = ["Camera: \(m.camera.phrase)"]
        if m.camera == .front {
            lines.append("Filmed from the front or back: joint angles, depth, lean and bar drift can't be measured from this view.")
        }
        if m.trackedShare < 0.6 {
            lines.append("You were found in only \(share(m.trackedShare)) of the frames, so these numbers are rough.")
        }
        let found = m.reps.count
        if found == loggedReps {
            lines.append("Reps found: \(found), as logged.")
        } else {
            lines.append("Reps found: \(found) (logged: \(loggedReps)). The clip may start or end mid-set, or a rep was hard to see.")
        }
        lines += m.reps.map { repLine($0, pattern: m.pattern, camera: m.camera) }
        return lines
    }

    /// One rep in words. Joint angles, depth, lean and drift are only measured from a side view:
    /// from the front or back the line gives just the turn and the tempo (and a calf raise's rise,
    /// which is up and down), and from an angle, or when the view is unclear, the numbers are
    /// marked as rough. Squat depth is left out from an angle.
    static func repLine(_ r: RepMeasure, pattern: LiftPattern, camera: CameraAngle = .side) -> String {
        var parts = ["Rep \(r.number): \(pattern.turnName) at \(seconds(r.turnTime))"]
        let rough = camera != .side
        func deg(_ v: Double) -> String { rough ? "about \(degrees(v))" : degrees(v) }
        func pct(_ v: Double) -> String { rough ? "about \(share(v))" : share(v) }
        if camera == .front {
            if pattern == .calfRaise, let s = r.riseShare { parts.append("heels rose about \(share(s)) of shin length") }
        } else {
            switch pattern {
            case .squat:
                if let k = r.kneeAtTurn { parts.append("knees \(deg(k))") }
                // From an angle the nearer of hip and knee sits lower in the picture when the
                // phone is above them (higher when it's below), by more than a squat's margin
                // either side of parallel, so even which one is lower can come out backwards.
                // Depth is left to the frames there.
                if let d = r.hipBelowKnee, camera != .angled { parts.append(depthText(d, rough: rough)) }
                if let l = r.leanAtTurn { parts.append("torso lean \(deg(l))") }
            case .hinge:
                if let h = r.hipAtTurn { parts.append("hips \(deg(h)) at lockout") }
                if let l = r.leanMax { parts.append("torso lean \(deg(l)) at the start") }
                if let c = r.earlyLeanChange {
                    parts.append(c > 5 ? "hips rose before the chest early in the pull (torso tipped \(deg(c)) further)" : "chest and hips rose together")
                }
                if let b = r.barDrift { parts.append("hands drifted \(pct(b)) of torso length" + (rough ? "" : " front to back")) }
            case .benchPress:
                if let e = r.elbowAtTurn { parts.append("elbows \(deg(e)) at the bottom") }
                if let e = r.elbowMax { parts.append("\(deg(e)) at lockout") }
                if let b = r.barDrift { parts.append("hands drifted \(pct(b)) of torso length") }
            case .overheadPress:
                if let e = r.elbowAtTurn { parts.append("elbows \(deg(e)) at lockout") }
                if let l = r.leanMax { parts.append("body lean up to \(deg(l))") }
                if let b = r.barDrift { parts.append("hands drifted \(pct(b)) of torso length") }
            case .row:
                if let e = r.elbowAtTurn { parts.append("elbows \(deg(e)) at the top") }
                if let l = r.leanAtTurn { parts.append("torso lean \(deg(l))") }
                if let lo = r.leanMin, let hi = r.leanMax { parts.append("torso moved \(deg(hi - lo)) during the rep") }
            case .curl:
                if let lo = r.elbowMin, let hi = r.elbowMax {
                    parts.append("elbow \(deg(lo)) at the top, \(deg(hi)) at the bottom (\(deg(hi - lo)) of range)")
                }
                if let s = r.upperArmSwing { parts.append("upper arm swung \(deg(s))") }
                if let lo = r.leanMin, let hi = r.leanMax { parts.append("torso moved \(deg(hi - lo))") }
            case .tricepsExtension:
                if let lo = r.elbowMin, let hi = r.elbowMax {
                    parts.append("elbow \(deg(lo)) at the stretch, \(deg(hi)) at lockout (\(deg(hi - lo)) of range)")
                }
                if let s = r.upperArmSwing { parts.append("upper arm moved \(deg(s))") }
            case .legPress:
                if let k = r.kneeMin { parts.append("knees \(deg(k)) at the bottom") }
                if let k = r.kneeMax {
                    parts.append(k >= 175 && !rough ? "knees fully straight at the top (\(degrees(k)))" : "\(deg(k)) at the top")
                }
            case .calfRaise:
                if let s = r.riseShare { parts.append("heels rose about \(share(s)) of shin length") }
            case .other:
                break
            }
        }
        let words = pattern.halfWords
        parts.append("\(words.first) \(seconds(r.turnTime - r.startTime)), \(words.second) \(seconds(r.endTime - r.turnTime))")
        return parts.joined(separator: " · ")
    }

    /// When the view couldn't be told (usually a side view whose far shoulder wasn't found), the
    /// thigh may look shorter than it is, so only the direction is given. Never used from an angle.
    static func depthText(_ d: Double, rough: Bool = false) -> String {
        if rough {
            if d > 0.05 { return "hips look below the knees" }
            if d >= -0.05 { return "hips look about level with the knees" }
            return "hips look above the knees"
        }
        let pct = Int((abs(d) * 100).rounded())
        if d > 0.05 { return "hips \(pct)% of thigh length below the knees (below parallel)" }
        if d >= -0.05 { return "hips level with the knees (about parallel)" }
        return "hips \(pct)% of thigh length above the knees (above parallel)"
    }

    static func degrees(_ v: Double) -> String { "\(Int(v.rounded()))°" }
    static func seconds(_ v: Double) -> String { String(format: "%.1f s", max(0, v)) }
    static func share(_ v: Double) -> String { "\(Int((v * 100).rounded()))%" }
}

// MARK: - A saved check

/// A finished form check, saved with the set as JSON.
struct FormCheck: Codable, Hashable {
    /// The video that was checked. A replaced video makes the check stale.
    var videoFileName: String
    var checkedAt: Date
    var aspect: Double
    var duration: Double
    var frames: [FormKeyFrame]
    /// nil when the lifter couldn't be tracked.
    var measurements: FormMeasurements?
    /// nil when only the phone's measurements were run.
    var feedback: FormFeedback?
    var model: String?
    var inputTokens: Int?
    var outputTokens: Int?
    /// What Claude's review cost, in dollars.
    var cost: Double?

    init(videoFileName: String, checkedAt: Date, aspect: Double, duration: Double, frames: [FormKeyFrame], measurements: FormMeasurements?) {
        self.videoFileName = videoFileName
        self.checkedAt = checkedAt
        self.aspect = aspect
        self.duration = duration
        self.frames = frames
        self.measurements = measurements
    }

    var estimatedCost: Double? {
        if let cost { return cost }
        guard let model, let inputTokens, let outputTokens else { return nil }
        return FormCoachPricing.dollars(model: model, input: inputTokens, output: outputTokens)
    }

    func encoded() -> String? {
        let encoder = JSONEncoder()
        encoder.dateEncodingStrategy = .iso8601
        guard let data = try? encoder.encode(self) else { return nil }
        return String(data: data, encoding: .utf8)
    }

    static func decode(_ json: String) -> FormCheck? {
        let decoder = JSONDecoder()
        decoder.dateDecodingStrategy = .iso8601
        return try? decoder.decode(FormCheck.self, from: Data(json.utf8))
    }
}
